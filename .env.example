# ==============================================================================
# MediShare Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or production credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Compass / Local / Atlas)
# ------------------------------------------------------------------------------
# Local MongoDB (Default for development & Compass):
MONGODB_URI=mongodb://127.0.0.1:27017

# Remote MongoDB Atlas Example (Uncomment and set your credentials for production):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=medishare

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION SECRETS (JWT & REFRESH TOKENS)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long in production.
# Generate secure random secrets using: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars-long
REFRESH_SECRET=your-secure-refresh-secret-at-least-32-chars-long

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC KEY ENCRYPTION (AES-256-GCM KEK)
# ------------------------------------------------------------------------------
# Used to encrypt Ed25519 issuer private keys stored in the database.
# Must be exactly 32 bytes or 32 characters in production.
# Generate secure key using: openssl rand -base64 32
KEY_ENCRYPTION_KEY=your-secure-kek-key-at-least-32-chars-long

# ------------------------------------------------------------------------------
# 5. OPTIONAL ENFORCEMENTS
# ------------------------------------------------------------------------------
# Set to 'true' in production to halt server startup if any security check fails.
STRICT_ENV_CHECK=false
